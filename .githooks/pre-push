#!/usr/bin/env bash
# Runs the same checks as CI before every push. Install with `make install-hooks`;
# skip once with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: gofmt"
unformatted="$(gofmt -l .)"
if [[ -n "$unformatted" ]]; then
  echo "Not gofmt-formatted (run 'make fmt'):" >&2
  echo "$unformatted" >&2
  exit 1
fi

echo "pre-push: make lint"
make --no-print-directory lint

echo "pre-push: go test"
go test ./... -count=1
